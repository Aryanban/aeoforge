# ==============================================================================
# AEOForge Environment Configuration
# Meta Global AI Developer Hackathon 2026
# ==============================================================================

# Meta AI / Meta Model API Configuration
META_MODEL_API_KEY=your_meta_model_api_key_here
META_MODEL_NAME=meta/llama-3.2-11b-vision-instruct
META_MODEL_API_BASE=https://api.meta.ai/v1

# Optional: Local Llama Stack Endpoint (e.g. running via Ollama / vLLM / Llama Stack Server)
LLAMA_STACK_ENDPOINT=http://localhost:5001
USE_LOCAL_LLAMA=false

# AEOForge Application Server Configuration
AEOFORGE_HOST=0.0.0.0
AEOFORGE_PORT=8000
AEOFORGE_ENV=development
DEBUG=true

# Playwright & Browser Settings
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_FAST_ROUTE_FILTER=true

# Cache & Storage
AEOFORGE_CACHE_DIR=.cache/aeoforge
AEOFORGE_DB_PATH=aeoforge.db
